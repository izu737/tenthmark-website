{
  "name": "Handout Digestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1111111-1111-1111-1111-111111111101",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 400],
      "webhookId": "handout-digestion-webhook-v1",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.photo }}",
                    "rightValue": "",
                    "operator": {
                      "type": "array",
                      "operation": "notEmpty"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "photo"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.document }}",
                    "rightValue": "",
                    "operator": {
                      "type": "object",
                      "operation": "notEmpty"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "document"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "a1111111-1111-1111-1111-111111111102",
      "name": "Check File Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 400]
    },
    {
      "parameters": {
        "jsCode": "const photos = $input.first().json.message.photo;\nconst largest = photos[photos.length - 1];\nconst chatId = $input.first().json.message.chat.id;\nreturn [{ json: { file_id: largest.file_id, chat_id: chatId, file_type: \"image\" } }];"
      },
      "id": "a1111111-1111-1111-1111-111111111103",
      "name": "Get Photo File ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 240],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const doc = $input.first().json.message.document;\nconst chatId = $input.first().json.message.chat.id;\nreturn [{ json: { file_id: doc.file_id, chat_id: chatId, file_type: doc.mime_type === \"application/pdf\" ? \"pdf\" : \"image\" } }];"
      },
      "id": "a1111111-1111-1111-1111-111111111104",
      "name": "Get Document File ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 400],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Please send a photo or document file (PDF or image).",
        "additionalFields": {}
      },
      "id": "a1111111-1111-1111-1111-111111111105",
      "name": "No File Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 560],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "a1111111-1111-1111-1111-111111111106",
      "name": "Merge Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [900, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.telegram.org/bot' + $credentials.telegramApi.accessToken + '/getFile?file_id=' + $json.file_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramApi",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111107",
      "name": "Get Telegram File Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 320],
      "onError": "continueErrorOutput",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const filePath = $input.first().json.result.file_path;\nconst prevNode = $('Merge Branches').first().json;\nconst chatId = prevNode.chat_id;\nconst fileType = prevNode.file_type || 'image';\nconst credentials = await this.getCredentials('telegramApi');\nconst token = credentials.accessToken;\nconst downloadUrl = `https://api.telegram.org/file/bot${token}/${filePath}`;\nreturn [{ json: { download_url: downloadUrl, chat_id: chatId, file_type: fileType, file_path: filePath } }];"
      },
      "id": "a1111111-1111-1111-1111-111111111108",
      "name": "Extract File Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 320],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "fileData"
            }
          }
        }
      },
      "id": "a1111111-1111-1111-1111-111111111109",
      "name": "Download File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 320],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst extractNode = $('Extract File Path').first().json;\nconst fileType = extractNode.file_type || 'image';\nconst chatId = extractNode.chat_id;\nconst binaryData = item.binary?.fileData;\n\nif (!binaryData) {\n  throw new Error('No binary file data found in previous node.');\n}\n\nconst base64String = binaryData.data;\nconst mimeType = binaryData.mimeType || 'image/jpeg';\n\nlet contentArray = [];\n\nif (fileType === 'pdf') {\n  contentArray = [\n    {\n      type: 'document',\n      source: {\n        type: 'base64',\n        media_type: 'application/pdf',\n        data: base64String\n      }\n    },\n    {\n      type: 'text',\n      text: 'Please process this document according to your instructions.'\n    }\n  ];\n} else {\n  const imageMime = mimeType.startsWith('image/') ? mimeType : 'image/jpeg';\n  contentArray = [\n    {\n      type: 'image',\n      source: {\n        type: 'base64',\n        media_type: imageMime,\n        data: base64String\n      }\n    },\n    {\n      type: 'text',\n      text: 'Please process this image according to your instructions.'\n    }\n  ];\n}\n\nreturn [{\n  json: {\n    content_array: contentArray,\n    chat_id: chatId,\n    file_type: fileType\n  }\n}];"
      },
      "id": "a1111111-1111-1111-1111-111111111110",
      "name": "Convert File to Base64 for Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 320],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 8000, system: 'You are a university study assistant for a computer engineering student in a Nigerian federal university. You will receive images of handwritten or printed lecture notes or handouts. These may be scanned with CamScanner or photographed directly.\\n\\nYour job is to produce four things in this exact order, each clearly labelled with the header shown:\\n\\n## TRANSCRIPTION\\nTranscribe every word of text visible in the images, preserving the original structure as closely as possible. If a word is unclear, write [unclear] in its place. Do not skip any content.\\n\\n## CLEAN NOTES\\nRewrite the transcribed content as clean, well-structured study notes. Use markdown formatting: headers, bullet points, numbered lists, bold for key terms. Organise logically even if the original is disorganised. Fix spelling and grammar. Make it easy to read.\\n\\n## EXAM QUESTIONS\\nGenerate exactly 20 exam questions based on the material. Mix question types: multiple choice, short answer, and calculation questions where relevant. After each question, provide a full model answer. Number them 1 through 20.\\n\\n## CHEAT SHEET\\nCreate a single-page cheat sheet. Include: all key definitions, all important formulas or equations, all named theorems or laws, all critical dates or facts. Format as a compact reference a student could review in 5 minutes before an exam.', messages: [{ role: 'user', content: $json.content_array }] }) }}"
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 320],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst claudeText = response.content[0].text;\nconst chatId = $input.first().json.chat_id ||\n  $('Convert File to Base64 for Claude').first().json.chat_id;\n\nconst chunkSize = 4000;\nconst chunks = [];\nfor (let i = 0; i < claudeText.length; i += chunkSize) {\n  chunks.push(claudeText.slice(i, i + chunkSize));\n}\n\nreturn chunks.map((chunk, index) => ({\n  json: {\n    text: chunk,\n    chat_id: chatId,\n    chunk_index: index,\n    total_chunks: chunks.length,\n    full_response: index === 0 ? claudeText : undefined\n  }\n}));"
      },
      "id": "a1111111-1111-1111-1111-111111111112",
      "name": "Extract Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 320],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "a1111111-1111-1111-1111-111111111113",
      "name": "Send Chunks to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2440, 320],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.chunk_index }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "a1111111-1111-1111-1111-111111111114",
      "name": "Filter First Chunk",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2660, 320]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{ new Date().toISOString().slice(0,16).replace('T','_').replace(':','-') + '_handout.md' }}",
        "driveId": {
          "__rl": true,
          "value": "myDrive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "STUDY_MATERIALS_FOLDER_ID",
          "mode": "id"
        },
        "binaryData": false,
        "fileContent": "={{ $json.full_response }}",
        "options": {
          "mimeType": "text/plain"
        }
      },
      "id": "a1111111-1111-1111-1111-111111111115",
      "name": "Save to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2880, 320],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "3",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Extract Claude Response').first().json.chat_id }}",
        "text": "✅ Done! Your handout has been fully processed. Notes, exam questions, and cheat sheet have been saved to your Google Drive \"Study Materials\" folder.",
        "additionalFields": {}
      },
      "id": "a1111111-1111-1111-1111-111111111116",
      "name": "Send Completion Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3100, 320],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Merge Branches').first()?.json?.chat_id || $json?.chat_id || '' }}",
        "text": "❌ Something went wrong processing your handout. Please try sending it again. If the problem continues, the file may be too large or in an unsupported format.",
        "additionalFields": {}
      },
      "id": "a1111111-1111-1111-1111-111111111117",
      "name": "Error Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2000, 580],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot API"
        }
      }
    }
  ],
