    {
      "id": "node-mb-04",
      "name": "Loom Demo Library",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [660, 300],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "loom_demos",
              "type": "string",
              "stringValue": "{\"demos\":[{\"name\":\"High Quality Icebreaker Generator\",\"description\":\"Generates personalized email openers that sound human by referencing specific, casual, and relevant details\",\"url\":\"https://www.loom.com/share/YOUR_VIDEO_ID_1\",\"relevant_for\":[\"SDR\",\"BDR\",\"sales\",\"outreach\",\"cold email\",\"lead generation\"]},{\"name\":\"High Intent Lead Scraper\",\"description\":\"Finds companies hiring for specific roles, enriches contacts, outputs outreach-ready lists. 8 hours of work in 30 minutes\",\"url\":\"https://www.loom.com/share/YOUR_VIDEO_ID_2\",\"relevant_for\":[\"SDR\",\"BDR\",\"lead generation\",\"prospecting\",\"sales ops\"]},{\"name\":\"AI SDR (Speed-to-Lead System)\",\"description\":\"Responds to positive replies within seconds and books calls automatically\",\"url\":\"https://www.loom.com/share/YOUR_VIDEO_ID_3\",\"relevant_for\":[\"SDR\",\"BDR\",\"sales\",\"automation\",\"inbound\"]}]}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-mb-05",
