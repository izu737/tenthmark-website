      "position": [880, 300],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "node-mb-06",
      "name": "Limit",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [1100, 300],
      "parameters": {
        "maxItems": 1
      }
    },
    {
      "id": "node-mb-07",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1320, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-mb-08",
      "name": "Filter Jobs",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [1540, 300],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a job filtering assistant. Respond only with valid JSON."
            },
            {
              "role": "user",
              "content": "=Determine if this job is a good fit based on my skills and experience.\n\nMY BACKGROUND:\n- Experience as SDR at Tenthmark (B2B outreach, cold email, LinkedIn, Loom videos)\n- Placement Matching Specialist at Virtual Internships (30% call-to-close rate, 20% higher call booking than colleagues)\n- Built AI automation systems: icebreaker generators, lead scrapers, speed-to-lead systems\n- Strong with n8n, Zapier, Claude API, GPT-4 API, Apollo, Apify\n- Remote work experience across US, UK, Australian time zones\n- Looking for: Part-time or contract SDR/BDR roles, remote, flexible hours\n\nJOB DETAILS:\nCompany: {{ $json.company_name }}\nTitle: {{ $json.job_title }}\nDescription: {{ $json.job_description }}\n\nRespond ONLY with this exact JSON format:\n{\"verdict\": \"true\"} or {\"verdict\": \"false\"}"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "3",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "node-mb-09",
      "name": "Job Match Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-match",
              "leftValue": "={{ $json.message.content }}",
              "rightValue": "\"verdict\": \"true\"",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-mb-10",
      "name": "Rewrite Resume",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [1980, 180],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Customize this resume for the specific job below. Highlight relevant experience and skills. Keep the same structure but tailor language to match job requirements.\n\nJOB:\nCompany: {{ $('Get Job Listings').item.json.company_name }}\nTitle: {{ $('Get Job Listings').item.json.job_title }}\nDescription: {{ $('Get Job Listings').item.json.job_description }}\n\nRESUME TEMPLATE:\n{{ $('Get Resume Template').item.json.body.content }}\n\nInstructions:\n1. Emphasize experience relevant to this specific role\n2. Mirror keywords from the job description where authentic\n3. Keep formatting clean (use Markdown)\n4. Do not invent experience or skills I don't have\n5. Output ONLY the resume content, no backticks or code blocks"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "3",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "node-mb-11",
      "name": "Generate Cover Letter",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [2200, 180],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Write a personalized cover letter for this job application. The letter should:\n1. Open with a specific hook about the company (not generic)\n2. Explain why I'm the right fit for this role\n3. Include 1-2 relevant automation demos from my portfolio (as Loom links)\n4. End with a clear call to action\n\nJOB:\nCompany: {{ $('Get Job Listings').item.json.company_name }}\nTitle: {{ $('Get Job Listings').item.json.job_title }}\nDescription: {{ $('Get Job Listings').item.json.job_description }}\nHiring Manager: {{ $('Get Job Listings').item.json.decision_maker_name }}\n\nMY COVER LETTER TEMPLATE:\n{{ $('Get Cover Letter Template').item.json.body.content }}\n\nMY LOOM DEMO LIBRARY (select 1-2 most relevant):\n{{ $('Loom Demo Library').item.json.loom_demos }}\n\nInstructions:\n1. Address to {{ $('Get Job Listings').item.json.decision_maker_name }} by first name\n2. Reference something specific about the company or role\n3. Select the most relevant Loom demos based on the job description\n4. Format the Loom links naturally in the letter (e.g., \"I built [an icebreaker generator](loom_url) that...\")\n5. Keep it concise (under 300 words)\n6. Sound human, not corporate\n7. Output ONLY the cover letter content in Markdown, no backticks"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "3",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "node-mb-12",
      "name": "Resume to HTML",
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [2420, 180],
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $('Rewrite Resume').item.json.message.content }}",
        "options": {}
      }
    },
    {
      "id": "node-mb-13",
