    {
      "id": "node-mb-20",
      "name": "Create Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [4180, 180],
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "sendTo": "={{ $('Get Job Listings').item.json.decision_maker_email }}",
        "subject": "={{ $('Get Job Listings').item.json.job_title }} at {{ $('Get Job Listings').item.json.company_name }}",
        "emailType": "html",
        "message": "=<p>Hey {{ $('Get Job Listings').item.json.decision_maker_name.split(' ')[0] }},</p>\n\n<p>I saw you're hiring for {{ $('Get Job Listings').item.json.job_title }} at {{ $('Get Job Listings').item.json.company_name }}.</p>\n\n<p>I've attached my resume and cover letter. The cover letter includes demos of automation systems I've built that are directly relevant to this role.</p>\n\n<p><strong>Quick links:</strong></p>\n<ul>\n  <li><a href=\"https://docs.google.com/document/d/{{ $('Create Resume Doc').item.json.documentId }}/edit\">Resume</a></li>\n  <li><a href=\"https://docs.google.com/document/d/{{ $('Create Cover Letter Doc').item.json.documentId }}/edit\">Cover Letter (includes Loom demos)</a></li>\n</ul>\n\n<p>Happy to hop on a quick call if you'd like to learn more.</p>\n\n<p>Best,<br>Izuchukwu Okafor</p>",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "5",
          "name": "Gmail account"
        }
      }
    }
