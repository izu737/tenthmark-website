    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst courseData = $('Find Course for Today').first().json;\n\nconst recent = rows.slice(-10);\n\nconst dateStr = new Date().toLocaleDateString('en-NG', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'\n});\n\nlet summary = `📊 *Quiz Performance Summary*\\n📅 ${dateStr}\\n\\n`;\nsummary += `✅ *Today:* ${courseData.score}/${courseData.total} (${courseData.percentage}%) — _${courseData.course}_\\n\\n`;\n\nif (recent.length > 0) {\n  summary += `*Recent Results (last ${recent.length}):*\\n`;\n  for (const row of recent) {\n    const d = (row.json.Date || 'N/A').substring(5);\n    const c = (row.json.Course || 'N/A').substring(0, 10);\n    const sc = parseInt(row.json.Score || 0);\n    const tot = parseInt(row.json.Total || 10);\n    const pct = tot > 0 ? Math.round((sc / tot) * 100) : 0;\n    const filled = Math.round(pct / 10);\n    const bar = '█'.repeat(filled) + '░'.repeat(10 - filled);\n    summary += `${d} | ${c}: [${bar}] ${sc}/${tot}\\n`;\n  }\n\n  const avg = recent.reduce((sum, r) => {\n    const sc = parseInt(r.json.Score || 0);\n    const tot = parseInt(r.json.Total || 10);\n    return sum + (tot > 0 ? sc / tot : 0);\n  }, 0) / recent.length * 100;\n\n  summary += `\\n*Overall Average: ${Math.round(avg)}%*\\n\\n`;\n\n  let motivation;\n  if (avg >= 80) motivation = '🌟 Excellent! You are on the honour roll track!';\n  else if (avg >= 65) motivation = '💪 Good work! Keep pushing for that A grade!';\n  else if (avg >= 50) motivation = '📚 Steady progress. More review will push you higher!';\n  else motivation = '🔥 Do not stop! Every quiz is a step forward. You got this!';\n\n  summary += motivation;\n} else {\n  summary += '_No history yet. Keep taking quizzes!_';\n}\n\nreturn [{ json: { summary_text: summary, chat_id: courseData.chat_id } }];"
      },
