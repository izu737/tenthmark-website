      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "score-prefix-check",
              "leftValue": "={{ ($json.message?.text || '').toUpperCase().startsWith('SCORE:') }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "d1111111-1111-1111-1111-111111111102",
      "name": "Check SCORE Prefix",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = msg.text || '';\nconst chatId = msg.chat?.id;\n\nconst match = text.match(/SCORE:\\s*(\\d+)\\s*\\/\\s*(\\d+)/i);\nif (!match) {\n  return [{ json: {\n    parse_error: true,\n    chat_id: chatId,\n    original_text: text,\n    error_message: 'Could not parse score. Please use format: SCORE: 7/10'\n  } }];\n}\n\nconst score = parseInt(match[1]);\nconst total = parseInt(match[2]);\nconst percentage = total > 0 ? Math.round((score / total) * 100) : 0;\n\nreturn [{ json: {\n  parse_error: false,\n  score,\n  total,\n  percentage,\n  chat_id: chatId,\n  date: new Date().toISOString().split('T')[0],\n  original_text: text\n} }];"
      },
      "id": "d1111111-1111-1111-1111-111111111103",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
