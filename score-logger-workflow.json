    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst scoreData = $('Parse Score').first().json;\n\nconst today = new Date();\nconst days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst dayName = days[today.getDay()];\n\nlet todayRow = null;\nfor (const item of items) {\n  const rowDay = (item.json.Day || item.json.day || '').toString().trim();\n  if (rowDay.toLowerCase() === dayName.toLowerCase()) {\n    todayRow = item.json;\n    break;\n  }\n}\n\nconst course = todayRow ? (todayRow.Course || todayRow.course || 'Unknown Course') : 'Unknown Course';\n\nreturn [{ json: {\n  course,\n  day: dayName,\n  score: scoreData.score,\n  total: scoreData.total,\n  percentage: scoreData.percentage,\n  chat_id: scoreData.chat_id,\n  date: scoreData.date\n} }];"
      },
