    {
      "parameters": {
        "jsCode": "// Collect all variation results and save metadata\nconst v1 = $input.all()[0].json;\nconst v2 = $input.all()[1].json;\nconst v3 = $input.all()[2].json;\n\nconst outputFolder = $node['Set Variables'].json.outputFolder;\nconst timestamp = Date.now();\n\nconst results = [\n  { variation: 1, url: v1.output, status: v1.status, localPath: `${outputFolder}/thumbnail_v1_${timestamp}.jpg` },\n  { variation: 2, url: v2.output, status: v2.status, localPath: `${outputFolder}/thumbnail_v2_${timestamp}.jpg` },\n  { variation: 3, url: v3.output, status: v3.status, localPath: `${outputFolder}/thumbnail_v3_${timestamp}.jpg` }\n];\n\nreturn [{ json: { results, outputFolder, timestamp, success: true } }];"
      },
