            },
            {
              "name": "replicateVersion",
              "value": "latest"
            },
            {
              "name": "outputFolder",
              "value": "/home/user/tenthmark-website/thumbnail-generator/output"
            },
            {
              "name": "referencePhotosFolder",
              "value": "/home/user/tenthmark-website/thumbnail-generator/reference_photos"
            },
            {
              "name": "inputUrl",
              "value": "={{$json.body.url}}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-vars",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Detect if input is YouTube URL or direct image URL\nconst url = $input.first().json.inputUrl;\nconst isYoutube = /(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/.test(url);\n\nlet thumbnailUrl = url;\nif (isYoutube) {\n  const match = url.match(/(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/);\n  const videoId = match[1];\n  // Use maxresdefault for 1920x1080; fall back to hqdefault\n  thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;\n}\n\nreturn [{ json: { ...($input.first().json), thumbnailUrl, isYoutube } }];"
      },
      "id": "node-resolve-url",
      "name": "Resolve Thumbnail URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{$json.thumbnailUrl}}",
        "responseFormat": "file",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "node-download-thumbnail",
      "name": "Download Source Thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "command": "=python3 /home/user/tenthmark-website/thumbnail-generator/scripts/face_detection.py \"{{$json.thumbnailUrl}}\" \"{{$json.outputFolder}}\""
      },
      "id": "node-face-detection",
      "name": "Analyze Face Direction",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse face detection output and find best reference photo match\nconst output = $input.first().json.stdout;\nlet faceData;\ntry {\n  faceData = JSON.parse(output);\n} catch (e) {\n  throw new Error('Face detection failed: ' + output);\n}\n\nconst { yaw, pitch } = faceData;\n\n// Reference photo angles (name -> [yaw_degrees, pitch_degrees])\nconst referenceAngles = {\n  'front_center.jpg': [0, 0],\n  'left_15.jpg': [-15, 0],\n  'left_30.jpg': [-30, 0],\n  'right_15.jpg': [15, 0],\n  'right_30.jpg': [30, 0],\n  'tilt_up_15.jpg': [0, -15],\n  'tilt_down_15.jpg': [0, 15],\n  'left_15_up_10.jpg': [-15, -10],\n  'right_15_up_10.jpg': [15, -10]\n};\n\n// Euclidean distance calculation\nconst distances = Object.entries(referenceAngles).map(([photo, [refYaw, refPitch]]) => ({\n  photo,\n  distance: Math.sqrt(Math.pow(yaw - refYaw, 2) + Math.pow(pitch - refPitch, 2))\n}));\n\n// Sort by closest match\ndistances.sort((a, b) => a.distance - b.distance);\nconst top3 = distances.slice(0, 3);\n\nconst referencePhotosFolder = $input.first().json.referencePhotosFolder;\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    faceYaw: yaw,\n    facePitch: pitch,\n    bestMatch: referencePhotosFolder + '/' + top3[0].photo,\n    top3Matches: top3.map(m => ({ ...m, fullPath: referencePhotosFolder + '/' + m.photo }))\n  }\n}];"
      },
      "id": "node-find-best-ref",
      "name": "Find Best Reference Photo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.replicate.com/v1/predictions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Token {{$json.replicateApiKey}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "=latest"
            }
          ]
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"version\": \"latest\",\n  \"input\": {\n    \"target_image\": \"{{$json.thumbnailUrl}}\",\n    \"swap_image\": \"{{$json.bestMatch}}\",\n    \"face_index\": 0\n  }\n}",
        "options": {}
      },
      "id": "node-replicate-v1",
      "name": "Replicate Face Swap - Variation 1",
      "type": "n8n-nodes-base.httpRequest",
