      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "thumbnail-generator"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "replicateApiKey",
              "value": "={{$env.REPLICATE_API_KEY}}"
            },
            {
